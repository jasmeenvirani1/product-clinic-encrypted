# Server
PORT=4000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=medleads

# Auth
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sales recipient for the public "Custom Plan Enquiry" landing-page form.
# Changing this value (+ restart) changes where enquiry emails are sent —
# no code change required. Leave blank in this template; set a real address
# only in your local/deployed .env, never commit it.
SALES_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
FRONTEND_URL=http://localhost:3000

# Instagram (Meta Graph API) — each CLINIC (tenant) brings their OWN Meta
# Developer App and enters their App ID/App Secret/Access Token/Instagram
# Business Account ID directly in the Super Admin settings UI. These
# credentials are stored per-tenant in the database (instagram_sessions
# table), NOT here — there is no shared/global Meta App or webhook verify
# token. BACKEND_URL is used only to build the per-tenant webhook callback
# URL shown to the clinic (e.g. {BACKEND_URL}/api/webhooks/instagram/:tenantId/:slot).
BACKEND_URL=http://localhost:4000

# Google Calendar OAuth2 — unlike Instagram above, this IS a real
# redirect-based OAuth2 flow (single shared Google Cloud OAuth client used by
# all tenants; each clinic connects their OWN Google account through it).
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console and register the redirect URI {BACKEND_URL}/api/google/oauth/callback.
# Leave blank in this template; set real values only in your local/deployed
# .env, never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ char random secret used to encrypt Google access/refresh tokens at
# rest (AES-256-GCM, backend/utils/tokenCrypto.js). Deliberately separate
# from JWT_SECRET — never reuse JWT_SECRET for token encryption. Generate
# with e.g. `openssl rand -hex 32`. Leave blank in this template.
GOOGLE_TOKEN_ENCRYPTION_KEY=
